# ===========================================
# OSi-Plus Environment Variables
# ===========================================
#
# VERCEL DEPLOYMENT INSTRUCTIONS:
# 1. Create a Supabase project at https://supabase.com
# 2. Go to Project Settings → Database
# 3. Copy "Connection pooling" URL for DATABASE_URL
# 4. Copy "Direct connection" URL for DIRECT_URL
# 5. Add these variables in Vercel Project Settings → Environment Variables
#
# ===========================================

# Database (Supabase PostgreSQL recommended)
# Use connection pooling URL (port 6543) for DATABASE_URL
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Use direct connection URL (port 5432) for DIRECT_URL (migrations)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].supabase.com:5432/postgres"

# JWT Authentication
# Generate a secure secret: openssl rand -base64 64
JWT_SECRET="replace-with-a-64-char-random-secret-for-production"
JWT_EXPIRES_IN="7d"

# MT-01B1 permanece inactivo. No cambiar a HYBRID hasta MT-01B2.
MT01B_AUTH_MODE="LEGACY"
MT01B_TENANT_SWITCH_ENABLED="false"
# Fundación frontend V2 desacoplada; no activar antes de MT-01B2B.
VITE_MT01B2_CLIENT_ENABLED="false"
VITE_CRM_PIPELINE_CLIENT_MODE="DISABLED"
# Puente MT-01C2B3A inactivo; TENANT_WRITE requiere backfill y cutover aprobados.
COMMERCIAL_TENANCY_WRITE_MODE="LEGACY_ONLY"
COMMERCIAL_TENANCY_READ_MODE="LEGACY_ONLY"
# Autorización independiente de mutaciones generales; sólo LOCAL_ONLY fuera de Vercel.
COMMERCIAL_TENANCY_MUTATION_MODE="DISABLED"
# Se define únicamente al activar HYBRID: fecha futura, máximo siete días.
# MT01B_LEGACY_TOKEN_ACCEPT_UNTIL=""
# Secreto independiente de JWT_SECRET, mínimo 32 caracteres. Sólo se usa al activar V2.
# MT01B_REFRESH_TOKEN_PEPPER="replace-with-an-independent-random-secret"
# Lista explícita, separada por comas; nunca usar * con cookies.
# MT01B_ALLOWED_ORIGINS="https://example.invalid"

# Optional: API URL (defaults to /api in production)
# VITE_API_URL=/api

# Ambiente: Production / Preview (Vercel inyecta según deployment)
# Configurar en Vercel: Production → VITE_APP_ENV=production, Preview → VITE_APP_ENV=preview
# VITE_APP_ENV=production
