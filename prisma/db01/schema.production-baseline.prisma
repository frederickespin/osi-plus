  locations_service_cases_origin_location_idTolocations      locations               @relation("service_cases_origin_location_idTolocations", fields: [origin_location_id], references: [id])
  contacts_service_cases_owner_contact_idTocontacts          contacts?               @relation("service_cases_owner_contact_idTocontacts", fields: [owner_contact_id], references: [id])
  contacts_service_cases_payer_contact_idTocontacts          contacts?               @relation("service_cases_payer_contact_idTocontacts", fields: [payer_contact_id], references: [id])
  contacts_service_cases_primary_contact_idTocontacts        contacts                @relation("service_cases_primary_contact_idTocontacts", fields: [primary_contact_id], references: [id])
  surveys                                                    surveys[]

  @@index([case_code])
  @@index([created_at])
  @@index([mode, status])
  @@index([owner_contact_id, status])
  @@index([service_flags], map: "service_cases_service_flags_gin_idx", type: Gin)
}

model surcharge_catalog {
  id                         String                       @id
  code                       String                       @unique
  name                       String
  default_pricing_mode       SurchargePricingMode
  default_rate               Decimal                      @db.Decimal(14, 4)
  currency                   String
  applies_to                 Json                         @default("{}")
  created_at                 DateTime                     @default(now())
  updated_at                 DateTime
  account_surcharge_policies account_surcharge_policies[]

  @@index([currency])
}

model surveys {
  id                           String        @id
  case_id                      String
  survey_type                  String
  performed_at                 DateTime
  performed_by_contact_id      String?
  origin_access_confirmed      Boolean       @default(false)
  destination_access_confirmed Boolean       @default(false)
  volume_estimate              String?
  inventory_summary            String?
  special_handling_codes       Json          @default("[]")
  surcharges_possible_codes    Json          @default("[]")
  assumptions_codes            Json          @default("[]")
  evidence_asset_ids           Json          @default("[]")
  notes                        String?
  created_at                   DateTime      @default(now())
  service_cases                service_cases @relation(fields: [case_id], references: [id], onDelete: Cascade)
  contacts                     contacts?     @relation(fields: [performed_by_contact_id], references: [id])
}

model tariff_overrides {
  id                       String                   @id
  profile_id               String
  scope                    TariffOverrideScope
  mode                     TariffRateMode?
  route_key                String?
  key                      String
  value                    Json
  notes                    String?
  created_at               DateTime                 @default(now())
  updated_at               DateTime
  account_pricing_profiles account_pricing_profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([profile_id, scope, mode])
  @@index([route_key])
}

model tariff_rate_bands {
  id               String           @id
  rate_set_id      String
  from_value       Decimal          @db.Decimal(14, 4)
  to_value         Decimal?         @db.Decimal(14, 4)
  rate             Decimal          @db.Decimal(14, 4)
  fixed_fee        Decimal?         @db.Decimal(14, 4)
  unit             String
  meta             Json             @default("{}")
  created_at       DateTime         @default(now())
  updated_at       DateTime
  tariff_rate_sets tariff_rate_sets @relation(fields: [rate_set_id], references: [id], onDelete: Cascade)

  @@index([rate_set_id, from_value])
}

model tariff_rate_sets {
  id                 String              @id
  master_tariff_id   String
  mode               TariffRateMode
  measurement_system String
  density_reference  Decimal?            @db.Decimal(12, 4)
  minimum_charge     Decimal?            @db.Decimal(14, 4)
  base_fee           Decimal?            @db.Decimal(14, 4)
  meta               Json                @default("{}")
  created_at         DateTime            @default(now())
  updated_at         DateTime
  tariff_rate_bands  tariff_rate_bands[]
  master_tariffs     master_tariffs      @relation(fields: [master_tariff_id], references: [id], onDelete: Cascade)

  @@index([master_tariff_id, mode])
}

