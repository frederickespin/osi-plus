generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB01_DATABASE_URL")
}

model account_contacts {
  id                String   @id
  account_id        String
  contact_id        String
  relationship_role String
  accounts          accounts @relation(fields: [account_id], references: [id], onDelete: Cascade)
  contacts          contacts @relation(fields: [contact_id], references: [id], onDelete: Cascade)

  @@unique([account_id, contact_id, relationship_role])
}

model account_pricing_profiles {
  id                         String                       @id
  account_id                 String
  base_master_tariff_id      String
  currency_override          String?
  valid_from                 DateTime?
  valid_to                   DateTime?
  global_markup_pct          Decimal?                     @db.Decimal(7, 4)
  global_discount_pct        Decimal?                     @db.Decimal(7, 4)
  is_active                  Boolean                      @default(true)
  notes                      String?
  air_markup_pct             Decimal?                     @db.Decimal(7, 4)
  air_min_kg                 Decimal?                     @db.Decimal(14, 4)
  lcl_markup_pct             Decimal?                     @db.Decimal(7, 4)
  lcl_min_wm                 Decimal?                     @db.Decimal(14, 4)
  fcl_markup_pct             Decimal?                     @db.Decimal(7, 4)
  local_markup_pct           Decimal?                     @db.Decimal(7, 4)
  local_min_hours            Decimal?                     @db.Decimal(14, 4)
  local_base_zone_km         Decimal?                     @db.Decimal(14, 4)
  local_per_km_rate          Decimal?                     @db.Decimal(14, 4)
  local_min_trip_fee         Decimal?                     @db.Decimal(14, 4)
  after_hours_multiplier     Decimal?                     @db.Decimal(10, 4)
  weekend_multiplier         Decimal?                     @db.Decimal(10, 4)
  holiday_multiplier         Decimal?                     @db.Decimal(10, 4)
  created_at                 DateTime                     @default(now())
  updated_at                 DateTime
  code                       String                       @unique
  service_type               String?
  service_mode               String?
  customer_type              String?
  accounts                   accounts                     @relation(fields: [account_id], references: [id], onDelete: Cascade)
  master_tariffs             master_tariffs               @relation(fields: [base_master_tariff_id], references: [id])
  account_surcharge_policies account_surcharge_policies[]
  tariff_overrides           tariff_overrides[]

  @@index([account_id, is_active])
  @@index([base_master_tariff_id, is_active])
  @@index([service_type, service_mode, customer_type, is_active], map: "account_pricing_profiles_service_type_service_mode_customer_typ")
}

model account_surcharge_policies {
  id                       String                   @id
  profile_id               String
  surcharge_code           String
  handling                 AccountSurchargeHandling
  override_rate            Decimal?                 @db.Decimal(14, 4)
  meta                     Json                     @default("{}")
  created_at               DateTime                 @default(now())
  updated_at               DateTime
  account_pricing_profiles account_pricing_profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  surcharge_catalog        surcharge_catalog        @relation(fields: [surcharge_code], references: [code])

  @@unique([profile_id, surcharge_code])
  @@index([surcharge_code])
}

model accounts {
  id                       String                     @id
  account_type             AccountType
  legal_name               String
  tax_id                   String?
  default_currency         String
  billing_preferences      String?
  payment_instructions     String?
  created_at               DateTime                   @default(now())
  updated_at               DateTime                   @default(now())
  account_contacts         account_contacts[]
  account_pricing_profiles account_pricing_profiles[]
  service_cases            service_cases[]
}

model business_entities {
  id                    String                  @id
  code                  String                  @unique
  legal_name            String
  trade_name            String?
  entity_kind           EntityKind
  tax_id                String?
  country_code          String?
  phone                 String?
  email                 String?
  website               String?
  notes                 String?
  is_active             Boolean                 @default(true)
  created_at            DateTime                @default(now())
  updated_at            DateTime
  business_entity_types business_entity_types[]
  commission_agreements commission_agreements[]
  entity_contacts       entity_contacts[]
  lead_commissions      lead_commissions[]
  lead_parties          lead_parties[]

  @@index([entity_kind, is_active])
  @@index([legal_name])
}

model business_entity_types {
  id                 String            @id
  business_entity_id String
  entity_type_id     String
  created_at         DateTime          @default(now())
  business_entities  business_entities @relation(fields: [business_entity_id], references: [id], onDelete: Cascade)
  entity_types       entity_types      @relation(fields: [entity_type_id], references: [id], onDelete: Cascade)

  @@unique([business_entity_id, entity_type_id])
  @@index([entity_type_id])
}

model case_milestones {
  id                  String        @id
  case_id             String        @unique
  first_response_at   DateTime?
  icp_completed_at    DateTime?
  survey_scheduled_at DateTime?
  survey_completed_at DateTime?
  estimate_sent_at    DateTime?
  final_quote_sent_at DateTime?
  approved_at         DateTime?
  ops_handoff_at      DateTime?
  closed_at           DateTime?
  close_reason        String?
  service_cases       service_cases @relation(fields: [case_id], references: [id], onDelete: Cascade)

  @@index([final_quote_sent_at])
  @@index([first_response_at])
}

model catalog_assumptions {
  id          String   @id
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())
}

model catalog_materials {
  id          String   @id
  code        String   @unique
  name        String
  description String?
  unit        String?
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())
}

model catalog_service_flags {
  id          String   @id
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())
}

model catalog_service_types {
  id          String   @id
  code        String   @unique
  name        String
  category    String
  mode_policy String
  fixed_mode  String?
  active      Boolean  @default(true)
  metadata    Json     @default("{}")
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())
}

model catalog_special_handling {
  id          String   @id
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())
}

model catalog_surcharges {
  id           String   @id
  code         String   @unique
  name         String
  description  String?
  default_unit String?
  active       Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now())
}

model code_sequences {
  key        String   @id
  value      Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model commission_agreements {
  id                 String                 @id
  business_entity_id String
  applies_to         CommissionAppliesTo
  commission_type    CommissionType
  commission_value   Decimal                @db.Decimal(12, 2)
  currency           String
  service_type       CommercialServiceType?
  valid_from         DateTime?
  valid_to           DateTime?
  notes              String?
  is_active          Boolean                @default(true)
  created_at         DateTime               @default(now())
  updated_at         DateTime
  business_entities  business_entities      @relation(fields: [business_entity_id], references: [id], onDelete: Cascade)
  lead_commissions   lead_commissions[]

  @@index([business_entity_id, is_active])
}

model contacts {
  id                                                        String             @id
  full_name                                                 String
  phones                                                    Json               @default("[]")
  emails                                                    Json               @default("[]")
  whatsapp                                                  String?
  created_at                                                DateTime           @default(now())
  updated_at                                                DateTime           @default(now())
  account_contacts                                          account_contacts[]
  events                                                    events[]
  service_cases_service_cases_approver_contact_idTocontacts service_cases[]    @relation("service_cases_approver_contact_idTocontacts")
  service_cases_service_cases_owner_contact_idTocontacts    service_cases[]    @relation("service_cases_owner_contact_idTocontacts")
  service_cases_service_cases_payer_contact_idTocontacts    service_cases[]    @relation("service_cases_payer_contact_idTocontacts")
  service_cases_service_cases_primary_contact_idTocontacts  service_cases[]    @relation("service_cases_primary_contact_idTocontacts")
  surveys                                                   surveys[]
}

model crating_requests {
  id                      String               @id
  case_id                 String
  quote_id                String?
  status                  CratingRequestStatus
  items                   Json                 @default("[]")
  output_cost_summary     Json                 @default("{}")
  generated_line_item_ids Json                 @default("[]")
  created_at              DateTime             @default(now())
  updated_at              DateTime             @default(now())
  service_cases           service_cases        @relation(fields: [case_id], references: [id], onDelete: Cascade)
  quotes                  quotes?              @relation(fields: [quote_id], references: [id])
}

model entity_contacts {
  id                 String            @id
  business_entity_id String
  full_name          String
  position           String?
  email              String?
  phone              String?
  mobile             String?
  is_primary         Boolean           @default(false)
  notes              String?
  created_at         DateTime          @default(now())
  updated_at         DateTime
  business_entities  business_entities @relation(fields: [business_entity_id], references: [id], onDelete: Cascade)
  lead_parties       lead_parties[]

  @@index([business_entity_id, is_primary])
}

model entity_types {
  id                    String                  @id
  code                  EntityTypeCode          @unique
  name                  String
  description           String?
  business_entity_types business_entity_types[]
}

model evaluator_article_catalog_snapshots {
  id         String   @id
  version    Int
  items      Json     @default("[]")
  updated_at DateTime
  updated_by String?
}

model evaluator_visit_reports {
  id                String   @id
  external_visit_id String   @unique
  case_id           String
  case_code         String
  status            String   @default("SUBMITTED")
  payload_hash      String
  payload           Json
  item_count        Int      @default(0)
  piece_count       Int      @default(0)
  photo_count       Int      @default(0)
  revision          Int      @default(1)
  received_at       DateTime @default(now())
  confirmed_at      DateTime @default(now())
  submitted_by      String?
  created_at        DateTime @default(now())
  updated_at        DateTime

  @@index([case_id, confirmed_at])
  @@index([status, confirmed_at])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model events {
  id                     String                @id
  case_id                String
  event_type             CommercialEventType
  start_at               DateTime
  end_at                 DateTime
  status                 CommercialEventStatus @default(SCHEDULED)
  assigned_to_contact_id String?
  location_id            String?
  notes                  String?
  meta                   Json                  @default("{}")
  created_at             DateTime              @default(now())
  updated_at             DateTime              @default(now())
  contacts               contacts?             @relation(fields: [assigned_to_contact_id], references: [id])
  service_cases          service_cases         @relation(fields: [case_id], references: [id], onDelete: Cascade)
  locations              locations?            @relation(fields: [location_id], references: [id])

  @@index([case_id, event_type, start_at])
}

model global_commercial_settings {
  id                        String    @id
  version                   Int
  is_active                 Boolean   @default(false)
  is_scheduled              Boolean   @default(false)
  scheduled_activation_date DateTime? @db.Date
  activated_at              DateTime?
  activated_by              String?
  created_by                String
  km_metro                  Int
  km_interior               Int
  tarifa_base               Decimal   @db.Decimal(10, 2)
  visit_fee_minimo          Decimal   @db.Decimal(10, 2)
  margen_minimo             Decimal   @db.Decimal(5, 2)
  hub_principal_id          String
  created_at                DateTime  @default(now())
  transport_minimo          Decimal   @default(0) @db.Decimal(10, 2)
  osi_hubs                  osi_hubs  @relation(fields: [hub_principal_id], references: [id])

  @@index([is_active])
  @@index([is_scheduled])
  @@index([version])
}

model lead_addresses {
  id            String      @id
  lead_id       String
  address_role  AddressRole
  country       String?
  city          String?
  state         String?
  postal_code   String?
  address_line1 String?
  address_line2 String?
  notes         String?
  created_at    DateTime    @default(now())
  osi_leads     osi_leads   @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@index([lead_id, address_role])
}

model lead_commissions {
  id                      String                 @id
  lead_id                 String
  referral_entity_id      String
  commission_agreement_id String?
  base_amount             Decimal                @db.Decimal(14, 2)
  commission_type         CommissionType
  commission_value        Decimal                @db.Decimal(12, 2)
  commission_amount       Decimal                @db.Decimal(14, 2)
  currency                String
  status                  CommissionStatus       @default(PENDING)
  notes                   String?
  created_at              DateTime               @default(now())
  updated_at              DateTime
  commission_agreements   commission_agreements? @relation(fields: [commission_agreement_id], references: [id])
  osi_leads               osi_leads              @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  business_entities       business_entities      @relation(fields: [referral_entity_id], references: [id])

  @@index([lead_id, status])
  @@index([referral_entity_id, status])
}

model lead_parties {
  id                 String            @id
  lead_id            String
  business_entity_id String
  contact_id         String?
  role               LeadPartyRole
  is_primary         Boolean           @default(false)
  notes              String?
  created_at         DateTime          @default(now())
  business_entities  business_entities @relation(fields: [business_entity_id], references: [id])
  entity_contacts    entity_contacts?  @relation(fields: [contact_id], references: [id])
  osi_leads          osi_leads         @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@index([business_entity_id])
  @@index([contact_id])
  @@index([lead_id, role])
}

model lead_service_requirements {
  id              String            @id
  lead_service_id String
  requirement_key String
  status          RequirementStatus @default(PENDING)
  notes           String?
  created_at      DateTime          @default(now())
  updated_at      DateTime
  lead_services   lead_services     @relation(fields: [lead_service_id], references: [id], onDelete: Cascade)

  @@index([lead_service_id, status])
}

model lead_services {
  id                        String                      @id
  lead_id                   String
  service_type              CommercialServiceType
  is_primary                Boolean                     @default(false)
  sequence                  Int?
  notes                     String?
  created_at                DateTime                    @default(now())
  lead_service_requirements lead_service_requirements[]
  osi_leads                 osi_leads                   @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@index([lead_id, service_type])
}

model lead_stage_history {
  id                 String     @id
  lead_id            String
  from_stage         LeadStage?
  to_stage           LeadStage
  changed_by_user_id String?
  comment            String?
  created_at         DateTime   @default(now())
  osi_leads          osi_leads  @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@index([lead_id, created_at])
  @@index([to_stage, created_at])
}

model location_access_profiles {
  id                 String            @id
  location_id        String            @unique
  floor_number       Int?
  elevator_available Boolean           @default(false)
  elevator_notes     String?
  stairs_floors      Int?
  parking_difficulty ParkingDifficulty @default(MEDIUM)
  long_carry_band    LongCarryBand     @default(NONE)
  truck_restrictions String?
  building_rules     String?
  risk_notes         String?
  photos_asset_ids   Json              @default("[]")
  updated_at         DateTime          @default(now())
  locations          locations         @relation(fields: [location_id], references: [id], onDelete: Cascade)
}

model locations {
  id                                                             String                    @id
  label                                                          String
  address_line                                                   String
  sector                                                         String?
  city                                                           String
  province                                                       String?
  country                                                        String
  geo_lat                                                        Decimal?                  @db.Decimal(10, 7)
  geo_lng                                                        Decimal?                  @db.Decimal(10, 7)
  location_type                                                  LocationType
  created_at                                                     DateTime                  @default(now())
  updated_at                                                     DateTime                  @default(now())
  events                                                         events[]
  location_access_profiles                                       location_access_profiles?
  service_cases_service_cases_destination_location_idTolocations service_cases[]           @relation("service_cases_destination_location_idTolocations")
  service_cases_service_cases_origin_location_idTolocations      service_cases[]           @relation("service_cases_origin_location_idTolocations")

  @@index([city, sector])
}

model master_tariffs {
  id                       String                     @id
  code                     String                     @unique
  name                     String
  scope                    MasterTariffScope
  currency                 String
  is_active                Boolean                    @default(true)
  notes                    String?
  created_at               DateTime                   @default(now())
  updated_at               DateTime
  coverage_options         Json                       @default("[]")
  service_rules            Json                       @default("[]")
  account_pricing_profiles account_pricing_profiles[]
  tariff_rate_sets         tariff_rate_sets[]

  @@index([currency, is_active])
  @@index([scope, is_active])
}

model operational_compensation_configs {
  id         String   @id
  version    Int
  data       Json
  updated_at DateTime
  updated_by String?
}

model osi_clients {
  id                        String              @id
  code                      String              @unique
  name                      String
  email                     String
  phone                     String
  address                   String
  type                      String
  status                    String
  totalServices             Int                 @default(0)
  lastService               String?
  createdAt                 String
  fiscalName                String?
  taxId                     String?
  billingAddress            String?
  paymentMethod             String?
  currency                  String?
  paymentTerms              String?
  accountsPayableName       String?
  accountsPayableEmail      String?
  accountsPayablePhone      String?
  complianceNotes           String?
  kycCompleted              Boolean             @default(false)
  normalizedPhone           String?
  billingTaxId              String?
  serviceOriginAddress      String?
  serviceDestinationAddress String?
  updatedAt                 DateTime            @default(now())
  osi_kyc_documents         osi_kyc_documents[]
  osi_leads                 osi_leads[]
  osi_projects              osi_projects[]
  osi_surveys               osi_surveys[]
}

model osi_escalation_events {
  id                             String                          @id
  type                           String
  message                        String
  targetRoles                    String[]
  suggestionId                   String?
  createdAt                      DateTime                        @default(now())
  resolvedAt                     DateTime?
  resolvedById                   String?
  metadataJson                   Json?
  osi_ptf_adjustment_suggestions osi_ptf_adjustment_suggestions? @relation(fields: [suggestionId], references: [id])

  @@index([createdAt])
  @@index([suggestionId])
}

model osi_hubs {
  id                         String                       @id
  name                       String
  lat                        Float
  lng                        Float
  active                     Boolean                      @default(true)
  priority                   Int                          @default(1)
  created_at                 DateTime                     @default(now())
  global_commercial_settings global_commercial_settings[]

  @@index([active, priority])
}

model osi_kyc_documents {
  id             String            @id
  leadId         String?
  clientId       String?
  type           KycDocumentType
  url            String
  status         KycDocumentStatus @default(UPLOADED)
  note           String?
  uploadedByRole String?
  uploadedAt     DateTime          @default(now())
  verifiedAt     DateTime?
  osi_clients    osi_clients?      @relation(fields: [clientId], references: [id])
  osi_leads      osi_leads?        @relation(fields: [leadId], references: [id])

  @@index([clientId, type])
  @@index([leadId, type])
  @@index([status, uploadedAt])
}

model osi_lead_audit_logs {
  id         String     @id
  leadId     String
  actorId    String?
  actorRole  String
  action     String
  note       String?
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime   @default(now())
  osi_users  osi_users? @relation(fields: [actorId], references: [id])
  osi_leads  osi_leads  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model osi_lead_volume_estimates {
  id                       String                   @id
  leadId                   String                   @unique
  areaProfileId            String
  estimatedM3Base          Float
  adjustmentPct            Float                    @default(0)
  estimatedM3Final         Float
  confidence               LeadEstimateConfidence   @default(MED)
  notes                    String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @default(now())
  updatedById              String?
  osi_volume_area_profiles osi_volume_area_profiles @relation(fields: [areaProfileId], references: [id])
  osi_leads                osi_leads                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  osi_users                osi_users?               @relation(fields: [updatedById], references: [id])

  @@index([areaProfileId, updatedAt])
  @@index([confidence, updatedAt])
}

model osi_leads {
  id                        String                     @id
  code                      String                     @unique
  status                    String
  leadType                  LeadType?
  channel                   String?
  clientName                String
  phone                     String?
  email                     String?
  preliminaryOriginAddress  String?
  estimatedServiceType      String?
  estimatedMoveDate         String?
  pstCode                   String?
  originAddress             String?
  destinationAddress        String?
  originFloor               String?
  destinationFloor          String?
  accessType                String?
  allowedTimeWindow         String?
  serviceResponsibleName    String?
  paymentResponsibleName    String?
  billingCompanyName        String?
  surveyMethod              String?
  geoDistanceKm             Float?
  geoValidated              Boolean                    @default(false)
  viaticInformed            Boolean                    @default(false)
  acceptanceStatus          AcceptanceStatus           @default(PENDING)
  acceptanceEvidence        String?
  acceptanceNote            String?
  conversionStatus          LeadConversionStatus       @default(PENDING)
  confirmedServiceDate      String?
  lostReason                String?
  lostReasonNote            String?
  fiscalData                Json?
  kycRequired               Boolean                    @default(false)
  kycCompleted              Boolean                    @default(false)
  nestingRequired           Boolean                    @default(false)
  nestingCompleted          Boolean                    @default(false)
  fileNumber                String?
  convertedAt               DateTime?
  sentToKAt                 DateTime?
  gatewayCompletedAt        DateTime?
  createdByRole             String?
  updatedByRole             String?
  customerId                String?
  projectId                 String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @default(now())
  surveyRequired            Boolean                    @default(false)
  surveyStatus              SurveyStatus               @default(NOT_STARTED)
  surveyCompletedAt         DateTime?
  surveyFlagsJson           Json?
  surveySummaryJson         Json?
  originCountryCode         String?
  destinationCountryCode    String?
  derivedMode               LeadDerivedMode            @default(PENDING)
  modeUpdatedAt             DateTime?
  visitSkipped              Boolean                    @default(false)
  visitSkipReason           String?
  visitSkipAt               DateTime?
  title                     String?
  source_channel_v2         LeadSourceChannel?
  stage_v2                  LeadStage?
  service_scope_v2          CommercialServiceType?
  lead_addresses            lead_addresses[]
  lead_commissions          lead_commissions[]
  lead_parties              lead_parties[]
  lead_services             lead_services[]
  lead_stage_history        lead_stage_history[]
  osi_kyc_documents         osi_kyc_documents[]
  osi_lead_audit_logs       osi_lead_audit_logs[]
  osi_lead_volume_estimates osi_lead_volume_estimates?
  osi_clients               osi_clients?               @relation(fields: [customerId], references: [id])
  osi_projects              osi_projects?              @relation(fields: [projectId], references: [id])
  osi_surveys               osi_surveys[]

  @@index([customerId])
  @@index([derivedMode, modeUpdatedAt])
  @@index([leadType, conversionStatus])
  @@index([projectId])
  @@index([source_channel_v2, updatedAt])
  @@index([stage_v2, updatedAt])
  @@index([status, updatedAt])
}

model osi_osi_change_logs {
  id          String   @id
  osiId       String
  actorUserId String?
  actorRole   String
  action      String
  fieldPath   String?
  beforeJson  Json?
  afterJson   Json?
  reason      String?
  createdAt   DateTime @default(now())
  osi_osis    osi_osis @relation(fields: [osiId], references: [id], onDelete: Cascade)

  @@index([osiId, createdAt])
