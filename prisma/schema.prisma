generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                                String                           @id @default(cuid())
  code                              String                           @unique
  name                              String
  email                             String                           @unique
  normalizedEmail                   String?                          @map("normalized_email") @db.VarChar(320)
  phone                             String
  role                              String
  status                            String
  department                        String?
  joinDate                          String
  points                            Int                              @default(0)
  rating                            Float                            @default(0)
  passwordHash                      String
  createdAt                         DateTime                         @default(now())
  updatedAt                         DateTime                         @updatedAt
  profilePhotoUrl                   String?
  employeeProfile                   Json?
  commercial_audit_logs             CommercialAuditLog[]
  leadAuditLogs                     LeadAuditLog[]                   @relation("LeadAuditActor")
  leadVolumeEstimatesUpdated        LeadVolumeEstimate[]             @relation("LeadVolumeEstimateUpdatedBy")
  pipelineCasesOwned                PipelineCase[]
  projectPgdsApplied                ProjectPgd[]                     @relation("ProjectPgdAppliedBy")
  projectPgdItemsValidated          ProjectPgdItem[]                 @relation("ProjectPgdItemValidatedBy")
  projectSignalsAcked               ProjectSignal[]                  @relation("ProjectSignalAckBy")
  templateVersionsApproved          TemplateVersion[]                @relation("TemplateApprovedBy")
  templateVersionsCreated           TemplateVersion[]                @relation("TemplateCreatedBy")
  templateVersionsRejected          TemplateVersion[]                @relation("TemplateRejectedBy")
  tipoServicioConfigsUpdated        TipoServicioConfig[]             @relation("TipoServicioConfigUpdatedBy")
  volumeAreaProfilesUpdated         VolumeAreaProfile[]              @relation("VolumeAreaProfileUpdatedBy")
  tenantMemberships                 TenantMembership[]
  acceptedProvisioningInvitations   EmployeeProvisioningInvitation[] @relation("EmployeeProvisioningInvitationAcceptedUser")
  activatedAdminIdentityInvitations AdminIdentityInvitation[]        @relation("AdminIdentityInvitationActivatedUser")

  @@map("osi_users")
}

model Tenant {
  id                               String                             @id @default(cuid())
  code                             String                             @unique @db.VarChar(64)
  name                             String                             @db.VarChar(160)
  legalName                        String?                            @map("legal_name") @db.VarChar(200)
  countryCode                      String?                            @map("country_code") @db.Char(2)
  timezone                         String                             @default("America/Santo_Domingo") @db.VarChar(64)
  defaultCurrency                  String                             @default("DOP") @map("default_currency") @db.Char(3)
  status                           TenantStatus                       @default(ACTIVE)
  provisioningSource               TenantProvisioningSource           @default(MANUAL) @map("provisioning_source")
  provisioningBatchId              String?                            @map("provisioning_batch_id")
  createdAt                        DateTime                           @default(now()) @map("created_at")
  updatedAt                        DateTime                           @updatedAt @map("updated_at")
  approval_requests                ApprovalRequest[]
  commercial_audit_logs            CommercialAuditLog[]
  crate_calculation_snapshots      crate_calculation_snapshots[]
  crate_settings_versions          crate_settings_versions[]
  logistic_override_approvals      LogisticOverrideApproval[]
  logistics_configuration_versions logistics_configuration_versions[]
  osi_geo_regions                  GeoRegion[]
  osi_transport_zone_rules         TransportZoneRule[]
  osi_vehicle_engine_settings      VehicleEngineSettings[]
  osi_vehicles                     Vehicle[]
  osi_zone_rules                   ZoneRule[]
  quote_change_order_policies      quote_change_order_policies[]
  quote_change_order_sequences     quote_change_order_sequences?
  quote_change_order_subjects      quote_change_order_subjects[]
  quote_change_orders              QuoteChangeOrder[]
  risk_engine_rules                risk_engine_rules[]
  risk_engine_settings             risk_engine_settings?
  risk_evaluations                 risk_evaluations[]
  employeeProfiles                 EmployeeProfile[]
  employeeProvisioningRequests     EmployeeProvisioningRequest[]
  employeeProvisioningInvitations  EmployeeProvisioningInvitation[]
  employeeAdminRoleProposals       EmployeeAdminRoleProposal[]
  adminIdentityInvitations         AdminIdentityInvitation[]
  clients                          Client[]
  projects                         Project[]
  leads                            Lead[]
  pipelineCases                    PipelineCase[]
  pipelineCaseCommands             PipelineCaseCommand[]
  memberships                      TenantMembership[]
  vehicle_import_batches           vehicle_import_batches[]
  vehicle_import_items             vehicle_import_items[]

  @@index([status])
  @@index([provisioningBatchId])
  @@map("tenants")
}

model TenantMembership {
  id                                                                                                                                            String                             @id @default(cuid())
  publicRef                                                                                                                                     String                             @default(dbgenerated("gen_random_uuid()")) @map("public_ref") @db.Uuid
  tenantId                                                                                                                                      String                             @map("tenant_id")
  userId                                                                                                                                        String                             @map("user_id")
  role                                                                                                                                          TenantMembershipRole
  status                                                                                                                                        TenantMembershipStatus             @default(ACTIVE)
  grantedPermissions                                                                                                                            String[]                           @default([]) @map("granted_permissions")
  deniedPermissions                                                                                                                             String[]                           @default([]) @map("denied_permissions")
  isDefault                                                                                                                                     Boolean                            @default(false) @map("is_default")
  authorizationVersion                                                                                                                          Int                                @default(1) @map("authorization_version")
  firstAccessAt                                                                                                                                 DateTime?                          @map("first_access_at")
  lastAccessAt                                                                                                                                  DateTime?                          @map("last_access_at")
  provisioningSource                                                                                                                            TenantProvisioningSource           @default(MANUAL) @map("provisioning_source")
  provisioningBatchId                                                                                                                           String?                            @map("provisioning_batch_id")
  createdAt                                                                                                                                     DateTime                           @default(now()) @map("created_at")
  updatedAt                                                                                                                                     DateTime                           @updatedAt @map("updated_at")
  approval_requests_approval_requests_tenant_id_assigned_approver_membership_id_assigned_approver_user_idTotenant_memberships                   ApprovalRequest[]                  @relation("approval_requests_tenant_id_assigned_approver_membership_id_assigned_approver_user_idTotenant_memberships")
  approval_requests_approval_requests_tenant_id_decider_membership_id_decider_user_idTotenant_memberships                                       ApprovalRequest[]                  @relation("approval_requests_tenant_id_decider_membership_id_decider_user_idTotenant_memberships")
  approval_requests_approval_requests_tenant_id_requester_membership_id_requester_user_idTotenant_memberships                                   ApprovalRequest[]                  @relation("approval_requests_tenant_id_requester_membership_id_requester_user_idTotenant_memberships")
  commercial_audit_logs                                                                                                                         CommercialAuditLog[]
  crate_calculation_snapshots                                                                                                                   crate_calculation_snapshots[]
  crate_settings_versions_crate_settings_versions_tenant_id_approved_by_membership_id_approved_by_user_idTotenant_memberships                   crate_settings_versions[]          @relation("crate_settings_versions_tenant_id_approved_by_membership_id_approved_by_user_idTotenant_memberships")
  crate_settings_versions_crate_settings_versions_tenant_id_created_by_membership_id_created_by_user_idTotenant_memberships                     crate_settings_versions[]          @relation("crate_settings_versions_tenant_id_created_by_membership_id_created_by_user_idTotenant_memberships")
  logistics_configuration_versions_logistics_configuration_versions_tenant_id_approved_by_membership_id_approved_by_user_idTotenant_memberships logistics_configuration_versions[] @relation("logistics_configuration_versions_tenant_id_approved_by_membership_id_approved_by_user_idTotenant_memberships")
  logistics_configuration_versions_logistics_configuration_versions_tenant_id_created_by_membership_id_created_by_user_idTotenant_memberships   logistics_configuration_versions[] @relation("logistics_configuration_versions_tenant_id_created_by_membership_id_created_by_user_idTotenant_memberships")
  osi_geo_regions_osi_geo_regions_tenant_id_approved_by_membership_id_approved_by_user_idTotenant_memberships                                   GeoRegion[]                        @relation("osi_geo_regions_tenant_id_approved_by_membership_id_approved_by_user_idTotenant_memberships")
  osi_geo_regions_osi_geo_regions_tenant_id_created_by_membership_id_created_by_user_idTotenant_memberships                                     GeoRegion[]                        @relation("osi_geo_regions_tenant_id_created_by_membership_id_created_by_user_idTotenant_memberships")
  osi_transport_zone_rules_osi_transport_zone_rules_tenant_id_approved_by_membership_id_approved_by_user_idTotenant_memberships                 TransportZoneRule[]                @relation("osi_transport_zone_rules_tenant_id_approved_by_membership_id_approved_by_user_idTotenant_memberships")
  osi_transport_zone_rules_osi_transport_zone_rules_tenant_id_created_by_membership_id_created_by_user_idTotenant_memberships                   TransportZoneRule[]                @relation("osi_transport_zone_rules_tenant_id_created_by_membership_id_created_by_user_idTotenant_memberships")
  osi_vehicle_engine_settings_osi_vehicle_engine_settings_tenant_id_approved_by_membership_id_approved_by_user_idTotenant_memberships           VehicleEngineSettings[]            @relation("osi_vehicle_engine_settings_tenant_id_approved_by_membership_id_approved_by_user_idTotenant_memberships")
  osi_vehicle_engine_settings_osi_vehicle_engine_settings_tenant_id_created_by_membership_id_created_by_user_idTotenant_memberships             VehicleEngineSettings[]            @relation("osi_vehicle_engine_settings_tenant_id_created_by_membership_id_created_by_user_idTotenant_memberships")
  osi_vehicles                                                                                                                                  Vehicle[]
  osi_zone_rules_osi_zone_rules_tenant_id_approved_by_membership_id_approved_by_user_idTotenant_memberships                                     ZoneRule[]                         @relation("osi_zone_rules_tenant_id_approved_by_membership_id_approved_by_user_idTotenant_memberships")
  osi_zone_rules_osi_zone_rules_tenant_id_created_by_membership_id_created_by_user_idTotenant_memberships                                       ZoneRule[]                         @relation("osi_zone_rules_tenant_id_created_by_membership_id_created_by_user_idTotenant_memberships")
  quote_change_order_commands                                                                                                                   quote_change_order_commands[]
  quote_change_order_policies                                                                                                                   quote_change_order_policies[]
  quote_change_order_subjects                                                                                                                   quote_change_order_subjects[]
  quote_change_orders_quote_change_orders_tenant_id_executed_by_membership_id_executed_by_user_idTotenant_memberships                           QuoteChangeOrder[]                 @relation("quote_change_orders_tenant_id_executed_by_membership_id_executed_by_user_idTotenant_memberships")
  quote_change_orders_quote_change_orders_tenant_id_requested_by_membership_id_requested_by_user_idTotenant_memberships                         QuoteChangeOrder[]                 @relation("quote_change_orders_tenant_id_requested_by_membership_id_requested_by_user_idTotenant_memberships")
  risk_engine_rules_risk_engine_rules_tenant_id_approved_by_membership_id_approved_by_user_idTotenant_memberships                               risk_engine_rules[]                @relation("risk_engine_rules_tenant_id_approved_by_membership_id_approved_by_user_idTotenant_memberships")
  risk_engine_rules_risk_engine_rules_tenant_id_created_by_membership_id_created_by_user_idTotenant_memberships                                 risk_engine_rules[]                @relation("risk_engine_rules_tenant_id_created_by_membership_id_created_by_user_idTotenant_memberships")
  risk_engine_settings                                                                                                                          risk_engine_settings[]             @relation("risk_engine_settings_actor") @ignore
  risk_evaluations                                                                                                                              risk_evaluations[]
  tenant                                                                                                                                        Tenant                             @relation(fields: [tenantId], references: [id])
  user                                                                                                                                          User                               @relation(fields: [userId], references: [id])
  vehicle_import_batches_vehicle_import_batches_tenant_id_confirmed_by_membership_id_confirmed_by_user_idTotenant_memberships                   vehicle_import_batches[]           @relation("vehicle_import_batches_tenant_id_confirmed_by_membership_id_confirmed_by_user_idTotenant_memberships")
  vehicle_import_batches_vehicle_import_batches_tenant_id_rolled_back_by_membership_id_rolled_back_by_user_idTotenant_memberships               vehicle_import_batches[]           @relation("vehicle_import_batches_tenant_id_rolled_back_by_membership_id_rolled_back_by_user_idTotenant_memberships")
  authSessions                                                                                                                                  AuthSession[]                      @relation("AuthSessionMembership")
  employeeProfile                                                                                                                               EmployeeProfile?                   @relation("EmployeeProfileMembership")
  supervisedEmployeeProfiles                                                                                                                    EmployeeProfile[]                  @relation("EmployeeProfileSupervisor")
  provisionedEmployeeRequests                                                                                                                   EmployeeProvisioningRequest[]      @relation("EmployeeProvisioningRequestProvisionedMembership")
  issuedProvisioningInvitations                                                                                                                 EmployeeProvisioningInvitation[]   @relation("EmployeeProvisioningInvitationIssuer")
  issuedAdminIdentityInvitations                                                                                                                AdminIdentityInvitation[]          @relation("AdminIdentityInvitationIssuer")
  activatedAdminIdentityInvitations                                                                                                             AdminIdentityInvitation[]          @relation("AdminIdentityInvitationActivatedMembership")
  proposedEmployeeAdminRoles                                                                                                                    EmployeeAdminRoleProposal[]        @relation("EmployeeAdminRoleProposalProposer")
  supervisedProvisioningRequests                                                                                                                EmployeeProvisioningRequest[]      @relation("EmployeeProvisioningRequestSupervisor")
  enterpriseOwnedPipelineCases                                                                                                                  PipelineCase[]                     @relation("PipelineCaseEnterpriseOwner")
  pipelineCaseCommandsAsActor                                                                                                                   PipelineCaseCommand[]              @relation("PipelineCaseCommandActor")
  pipelineCaseCommandsAsPreviousOwner                                                                                                           PipelineCaseCommand[]              @relation("PipelineCaseCommandPreviousOwner")
  pipelineCaseCommandsAsResultingOwner                                                                                                          PipelineCaseCommand[]              @relation("PipelineCaseCommandResultingOwner")

  @@unique([tenantId, userId])
  @@unique([tenantId, publicRef], map: "tenant_memberships_tenant_id_public_ref_key")
  @@unique([tenantId, id, userId])
  @@index([tenantId, status, role])
  @@index([userId, status])
  @@index([userId, isDefault])
  @@index([provisioningBatchId])
  @@map("tenant_memberships")
}

model EmployeeProfile {
  id                     String                     @id @default(cuid())
  tenantId               String                     @map("tenant_id")
  membershipId           String                     @map("membership_id")
  userId                 String                     @map("user_id")
  employeeCode           String                     @map("employee_code") @db.VarChar(64)
  normalizedEmployeeCode String                     @map("normalized_employee_code") @db.VarChar(64)
  jobTitle               String?                    @map("job_title") @db.VarChar(120)
  departmentCode         String?                    @map("department_code") @db.VarChar(64)
  employmentStatus       EmployeeEmploymentStatus   @map("employment_status")
  contractType           EmployeeContractType?      @map("contract_type")
  availabilityStatus     EmployeeAvailabilityStatus @map("availability_status")
  supervisorMembershipId String?                    @map("supervisor_membership_id")
  supervisorUserId       String?                    @map("supervisor_user_id")
  hiredAt                DateTime?                  @map("hired_at") @db.Date
  contractStartsAt       DateTime?                  @map("contract_starts_at") @db.Date
  contractEndsAt         DateTime?                  @map("contract_ends_at") @db.Date
  terminatedAt           DateTime?                  @map("terminated_at") @db.Date
  provisioningSource     TenantProvisioningSource   @default(MANUAL) @map("provisioning_source")
  provisioningBatchId    String?                    @map("provisioning_batch_id") @db.VarChar(128)
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant                 Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  membership             TenantMembership           @relation("EmployeeProfileMembership", fields: [tenantId, membershipId, userId], references: [tenantId, id, userId], onDelete: Restrict, onUpdate: Cascade)
  supervisorMembership   TenantMembership?          @relation("EmployeeProfileSupervisor", fields: [tenantId, supervisorMembershipId, supervisorUserId], references: [tenantId, id, userId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, membershipId])
  @@unique([tenantId, membershipId, userId])
  @@unique([tenantId, normalizedEmployeeCode])
  @@index([tenantId, employmentStatus, departmentCode])
  @@index([tenantId, availabilityStatus])
  @@index([tenantId, supervisorMembershipId])
  @@index([provisioningBatchId])
  @@map("employee_profiles")
}

model EmployeeProvisioningRequest {
  id                      String                               @id @default(uuid())
  tenant_id               String
  approval_request_id     String
  identityMode            EmployeeProvisioningIdentityMode     @map("identity_mode")
  normalizedEmail         String                               @map("normalized_email") @db.VarChar(320)
  normalizedEmployeeCode  String                               @map("normalized_employee_code") @db.VarChar(64)
  jobTitle                String?                              @map("job_title") @db.VarChar(120)
  departmentCode          String?                              @map("department_code") @db.VarChar(64)
  employmentStatus        EmployeeEmploymentStatus             @map("employment_status")
  contractType            EmployeeContractType?                @map("contract_type")
  availabilityStatus      EmployeeAvailabilityStatus           @map("availability_status")
  supervisorMembershipId  String?                              @map("supervisor_membership_id")
  supervisorUserId        String?                              @map("supervisor_user_id")
  hiredAt                 DateTime?                            @map("hired_at") @db.Date
  contractStartsAt        DateTime?                            @map("contract_starts_at") @db.Date
  contractEndsAt          DateTime?                            @map("contract_ends_at") @db.Date
  terminatedAt            DateTime?                            @map("terminated_at") @db.Date
  requestedRole           TenantMembershipRole                 @map("requested_role")
  grantedPermissions      String[]                             @default([]) @map("granted_permissions")
  deniedPermissions       String[]                             @default([]) @map("denied_permissions")
  lifecycleStatus         EmployeeProvisioningLifecycleStatus? @map("lifecycle_status")
  lifecycleVersion        Int                                  @default(0) @map("lifecycle_version")
  provisionedUserId       String?                              @map("provisioned_user_id")
  provisionedMembershipId String?                              @map("provisioned_membership_id")
  provisionedAt           DateTime?                            @map("provisioned_at") @db.Timestamptz(6)
  activatedAt             DateTime?                            @map("activated_at") @db.Timestamptz(6)
  revokedAt               DateTime?                            @map("revoked_at") @db.Timestamptz(6)
  createdAt               DateTime                             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant                  Tenant                               @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "employee_provisioning_requests_tenant_fkey")
  approvalRequest         ApprovalRequest                      @relation(fields: [tenant_id, approval_request_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Cascade, map: "employee_provisioning_requests_approval_fkey")
  supervisorMembership    TenantMembership?                    @relation("EmployeeProvisioningRequestSupervisor", fields: [tenant_id, supervisorMembershipId, supervisorUserId], references: [tenantId, id, userId], onDelete: Restrict, onUpdate: Cascade, map: "employee_provisioning_requests_supervisor_fkey")
  provisionedMembership   TenantMembership?                    @relation("EmployeeProvisioningRequestProvisionedMembership", fields: [tenant_id, provisionedMembershipId, provisionedUserId], references: [tenantId, id, userId], onDelete: Restrict, onUpdate: Cascade, map: "employee_provisioning_requests_provisioned_membership_fkey")
  invitations             EmployeeProvisioningInvitation[]
  adminRoleProposals      EmployeeAdminRoleProposal[]

  @@unique([tenant_id, id])
  @@unique([tenant_id, approval_request_id], map: "employee_provisioning_requests_tenant_approval_key")
  @@index([tenant_id, lifecycleStatus, createdAt(sort: Desc)], map: "employee_provisioning_requests_tenant_lifecycle_created_idx")
  @@index([tenant_id, normalizedEmail], map: "employee_provisioning_requests_tenant_email_idx")
  @@index([tenant_id, normalizedEmployeeCode], map: "employee_provisioning_requests_tenant_employee_code_idx")
  @@index([tenant_id, provisionedMembershipId], map: "employee_provisioning_requests_tenant_provisioned_membership_id")
  @@map("employee_provisioning_requests")
}

model EmployeeProvisioningInvitation {
  id                    String                               @id @default(uuid())
  tenant_id             String
  provisioningRequestId String                               @map("provisioning_request_id")
  tokenHmac             String                               @unique @map("token_hmac") @db.Char(64)
  status                EmployeeProvisioningInvitationStatus
  expiresAt             DateTime                             @map("expires_at") @db.Timestamptz(6)
  attemptCount          Int                                  @default(0) @map("attempt_count")
  maxAttempts           Int                                  @map("max_attempts")
  issuedByMembershipId  String                               @map("issued_by_membership_id")
  issuedByUserId        String                               @map("issued_by_user_id")
  issueRequestId        String                               @map("issue_request_id") @db.VarChar(191)
  issuePayloadHash      String                               @map("issue_payload_hash") @db.Char(64)
  acceptanceRequestId   String?                              @map("acceptance_request_id") @db.VarChar(191)
  acceptancePayloadHash String?                              @map("acceptance_payload_hash") @db.Char(64)
  acceptedUserId        String?                              @map("accepted_user_id")
  acceptedAt            DateTime?                            @map("accepted_at") @db.Timestamptz(6)
  revokedAt             DateTime?                            @map("revoked_at") @db.Timestamptz(6)
  expiredAt             DateTime?                            @map("expired_at") @db.Timestamptz(6)
  createdAt             DateTime                             @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant                Tenant                               @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "employee_provisioning_invitations_tenant_fkey")
  provisioningRequest   EmployeeProvisioningRequest          @relation(fields: [tenant_id, provisioningRequestId], references: [tenant_id, id], onDelete: Restrict, onUpdate: Cascade, map: "employee_provisioning_invitations_request_fkey")
  issuerMembership      TenantMembership                     @relation("EmployeeProvisioningInvitationIssuer", fields: [tenant_id, issuedByMembershipId, issuedByUserId], references: [tenantId, id, userId], onDelete: Restrict, onUpdate: Cascade, map: "employee_provisioning_invitations_issuer_fkey")
  acceptedUser          User?                                @relation("EmployeeProvisioningInvitationAcceptedUser", fields: [acceptedUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "employee_provisioning_invitations_accepted_user_fkey")

  @@unique([tenant_id, id])
  @@unique([tenant_id, issueRequestId], map: "employee_provisioning_invitations_tenant_issue_request_key")
  @@unique([tenant_id, acceptanceRequestId], map: "employee_provisioning_invitations_tenant_acceptance_request_key")
  @@index([tenant_id, provisioningRequestId, createdAt(sort: Desc)], map: "employee_provisioning_invitations_tenant_request_created_idx")
  @@index([tenant_id, status, expiresAt], map: "employee_provisioning_invitations_tenant_status_expires_idx")
  @@map("employee_provisioning_invitations")
}

model AdminIdentityInvitation {
  id                    String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicRef             String                        @default(dbgenerated("gen_random_uuid()")) @map("public_ref") @db.Uuid
  tenantId              String                        @map("tenant_id")
  normalizedEmail       String                        @map("normalized_email") @db.VarChar(320)
  intendedRole          TenantMembershipRole          @default(A) @map("intended_role")
  grantedPermissions    String[]                      @default([]) @map("granted_permissions")
  tokenHash             String                        @unique @map("token_hash") @db.Char(64)
  status                AdminIdentityInvitationStatus @default(PENDING)
  expiresAt             DateTime                      @map("expires_at") @db.Timestamptz(6)
  issuedByMembershipId  String                        @map("issued_by_membership_id")
  issuedByUserId        String                        @map("issued_by_user_id")
  activatedUserId       String?                       @map("activated_user_id")
  activatedMembershipId String?                       @map("activated_membership_id")
  requestId             String                        @map("request_id") @db.VarChar(191)
  payloadHash           String                        @map("payload_hash") @db.Char(64)
  consumedAt            DateTime?                     @map("consumed_at") @db.Timestamptz(6)
  revokedAt             DateTime?                     @map("revoked_at") @db.Timestamptz(6)
  createdAt             DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant                Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "admin_identity_invitations_tenant_fkey")
  issuerMembership      TenantMembership              @relation("AdminIdentityInvitationIssuer", fields: [tenantId, issuedByMembershipId, issuedByUserId], references: [tenantId, id, userId], onDelete: Restrict, onUpdate: Cascade, map: "admin_identity_invitations_issuer_fkey")
  activatedUser         User?                         @relation("AdminIdentityInvitationActivatedUser", fields: [activatedUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "admin_identity_invitations_activated_user_fkey")
  activatedMembership   TenantMembership?             @relation("AdminIdentityInvitationActivatedMembership", fields: [tenantId, activatedMembershipId, activatedUserId], references: [tenantId, id, userId], onDelete: Restrict, onUpdate: Cascade, map: "admin_identity_invitations_activated_membership_fkey")

  @@unique([tenantId, publicRef], map: "admin_identity_invitations_tenant_public_ref_key")
  @@unique([tenantId, requestId], map: "admin_identity_invitations_tenant_request_key")
  @@index([tenantId, normalizedEmail, status], map: "admin_identity_invitations_tenant_email_status_idx")
  @@index([tenantId, status, expiresAt], map: "admin_identity_invitations_tenant_status_expires_idx")
  @@map("admin_identity_invitations")
