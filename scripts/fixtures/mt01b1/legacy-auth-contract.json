{
  "loginMissing": {
    "status": 400,
    "headers": {
      "cache-control": "private, no-store",
      "vary": "Authorization, Origin",
      "content-type": "application/json; charset=utf-8"
    },
    "body": { "ok": false, "error": "email y password son requeridos" }
  },
  "loginInvalid": {
    "status": 401,
    "headers": {
      "cache-control": "private, no-store",
      "vary": "Authorization, Origin",
      "content-type": "application/json; charset=utf-8"
    },
    "body": { "ok": false, "error": "Credenciales inválidas" }
  },
  "loginMembershipMissing": {
    "status": 403,
    "headers": {
      "cache-control": "private, no-store",
      "vary": "Authorization, Origin",
      "content-type": "application/json; charset=utf-8"
    },
    "body": { "ok": false, "error": "MT01B_MEMBERSHIP_NOT_FOUND" }
  },
  "loginSuccess": {
    "status": 200,
    "headers": {
      "cache-control": "private, no-store",
      "vary": "Authorization, Origin",
      "content-type": "application/json; charset=utf-8"
    },
    "body": {
      "ok": true,
      "token": "[JWT]",
      "user": { "name": "Usuario Legacy Sintético" },
      "membershipSelection": {
        "required": false,
        "options": [
          {
            "membershipRef": "[MEMBERSHIP_REF]",
            "tenantName": "Empresa Legacy Sintética",
            "role": "N",
            "preferred": true
          }
        ]
      }
    }
  },
  "meSuccess": {
    "status": 200,
    "headers": {
      "cache-control": "private, no-store",
      "vary": "Authorization, Origin",
      "content-type": "application/json; charset=utf-8"
    },
    "body": {
      "ok": true,
      "user": {
        "name": "Usuario Legacy Sintético",
        "role": "N",
        "status": "active",
        "permissions": ["pipeline:view"],
        "deniedPermissions": ["osi:view"],
        "membership": {
          "membershipRef": "[MEMBERSHIP_REF]",
          "tenantName": "Empresa Legacy Sintética",
          "role": "N"
        },
        "memberships": [
          {
            "membershipRef": "[MEMBERSHIP_REF]",
            "tenantName": "Empresa Legacy Sintética",
            "role": "N",
            "preferred": true
          }
        ]
      }
    }
  }
}
